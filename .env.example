# Copy to .env.local for development, and add the same keys in
# Vercel → Settings → Environment Variables for production.
# Never commit real values.

# ── Sanity (content + bookings) ───────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=
# Server-only. Viewer token for the private dataset (public pages).
SANITY_API_READ_TOKEN=
# Server-only. Editor token for admin saves and guest holds.
SANITY_API_WRITE_TOKEN=

# ── Translations (scripts/i18n) ───────────────────────────────
# Only needed to RUN the translation scripts, never by the site itself —
# do not add this one in Vercel.
#   npm run i18n:status | i18n:extract | i18n:translate | i18n:apply
ANTHROPIC_API_KEY=

# ── Supabase (360° panorama bucket) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Lets the admin list the bucket in the tour editor.
SUPABASE_ANON_KEY=

# ── Admin login (/admin) ──────────────────────────────────────
# The one admin account.
ADMIN_USERNAME=henrik
# Salted scrypt hash of the password. Generate it with:
#   npm run admin:password
ADMIN_PASSWORD_HASH=
# 32+ random characters that sign the session cookie. Generate it with:
#   npm run admin:password -- --secret
# Changing this or the password hash signs every session out.
ADMIN_SESSION_SECRET=

# ── Booking alerts (Resend; verified sender domain required) ──
RESEND_API_KEY=
BOOKING_NOTIFY_EMAIL=
BOOKING_EMAIL_FROM=
# Optional separate 32+ character secret for hashing spam-limit identities.
# Falls back to ADMIN_SESSION_SECRET. Never use NEXT_PUBLIC_ for these values.
BOOKING_RATE_LIMIT_SECRET=
