# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# the documented template has no secrets
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/mockups

# Translation working files — drafts in transit to Sanity, not a source of truth.
# Regenerate any time with `npm run i18n:extract`.
/scripts/i18n/pending
# Sanity typegen artifact (regenerate with npm run typegen)
sanity/extract.json

# Sanity Studio runtime cache
.sanity/

# Sanity Studio production build output (`sanity build`)
/dist
