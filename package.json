{
  "name": "henriks-apartments",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "studio": "sanity dev",
    "studio:deploy": "sanity deploy",
    "typegen": "sanity schema extract --enforce-required-fields --path=./sanity/extract.json && sanity typegen generate",
    "admin:password": "node scripts/admin-password.mjs",
    "units:backfill-slugs": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backfill-former-slugs.mjs",
    "units:rewrite-copy": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/rewrite-unit-copy.mjs",
    "units:fix-elevator": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fix-elevator.mjs",
    "units:fix-internet": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fix-internet-speed.mjs",
    "i18n:status": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n/status.mjs",
    "i18n:extract": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n/extract.mjs",
    "i18n:translate": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n/translate.mjs",
    "i18n:apply": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n/apply.mjs",
    "test": "jest && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/common-areas.test.mjs scripts/i18n/lib.test.mjs",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@photo-sphere-viewer/core": "^5.15.1",
    "@photo-sphere-viewer/markers-plugin": "^5.15.1",
    "@photo-sphere-viewer/virtual-tour-plugin": "^5.15.1",
    "@sanity/client": "^7.27.0",
    "@sanity/image-url": "^1.2.0",
    "@sanity/vision": "^5.31.2",
    "framer-motion": "^13.2.0",
    "next": "16.3.3",
    "next-sanity": "^12.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^5.31.2",
    "styled-components": "^6.5.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
